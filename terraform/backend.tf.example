# Remote state — copy to backend.tf when deploying to real AWS.
#
# For local work (LocalStack + default state), leave this file alone and
# Terraform uses the default local backend writing to ./terraform.tfstate.
# backend.tf is in .gitignore so a reader can `cp backend.tf.example
# backend.tf`, edit, and never accidentally commit their state config.
#
# Bootstrap bucket + lock table need to exist before `terraform init`:
#
#   aws s3api create-bucket --bucket my-ecom-tfstate --region us-east-1
#   aws s3api put-bucket-versioning --bucket my-ecom-tfstate \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name my-ecom-tfstate-lock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST

# terraform {
#   backend "s3" {
#     bucket         = "my-ecom-tfstate"
#     key            = "ecommerce-aws-platform/terraform.tfstate"
#     region         = "us-east-1"
#     dynamodb_table = "my-ecom-tfstate-lock"
#     encrypt        = true
#   }
# }
