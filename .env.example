# ecommerce-aws-platform — example environment configuration.
#
# Copy to `.env` for local work. `.env` is gitignored; this file is the
# committed schema. Every variable here is optional — the default path
# runs fully against LocalStack + DuckDB with zero AWS cost.

# ---------- LocalStack (default local path, free) ----------------------
# Spin up with `localstack start -d` (requires Docker/Colima running).
# Every boto3 client in the codebase respects this endpoint when set.
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-1

# ---------- Real AWS (optional, costs real money) ---------------------
# Only set these if you want to deploy to a real AWS account. The
# committed Terraform works unchanged — point AWS_PROFILE at a profile
# with credentials in ~/.aws/credentials, or set the usual AWS vars.
# AWS_PROFILE=ecom-aws-dev
# AWS_REGION=us-east-1

# ---------- Project-specific knobs -----------------------------------
# S3 bucket names — defaults are generated with the AWS account ID so they
# don't collide; override to pin a specific name for a shared dev account.
# ECOM_BUCKET_BRONZE=ecom-bronze-local
# ECOM_BUCKET_SILVER=ecom-silver-local
# ECOM_BUCKET_GOLD=ecom-gold-local

# Local DuckDB warehouse path — used by the Phase 10 Athena / Redshift
# Spectrum stand-in. Points at the gold Parquet lakehouse on disk.
# ECOM_DUCKDB_PATH=./warehouse/ecom.duckdb
